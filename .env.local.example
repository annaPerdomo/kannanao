# Rename this file to .env.local and fill in your keys

# Google Gemini API key
GEMINI_API_KEY=your_gemini_api_key_here

# Unsplash API access key
UNSPLASH_ACCESS_KEY=your_unsplash_access_key_here

# Supabase service role key (for AI image upload to Storage)
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here

# Web Push notifications (generate with: npx web-push generate-vapid-keys)
NEXT_PUBLIC_VAPID_PUBLIC_KEY=your_vapid_public_key_here
VAPID_PRIVATE_KEY=your_vapid_private_key_here
VAPID_SUBJECT=mailto:your-email@example.com

# Daily review-reminder cron (generate with: openssl rand -hex 32)
# Vercel attaches this as `authorization: Bearer <value>` to its cron requests
# once the var exists on the project. /api/cron/review-reminders 401s without it,
# so a missing value means reminders are silently off — never an open endpoint.
CRON_SECRET=your_cron_secret_here

# Timezone the reminder job calls "today". Must stay paired with the cron hour in
# vercel.json (currently 23:00 UTC — late afternoon in America/Los_Angeles).
REMINDER_TIMEZONE=America/Los_Angeles

# Admin username (the part before @kannanao.local)
NEXT_PUBLIC_ADMIN_USERNAME=test
ADMIN_USERNAME=test
